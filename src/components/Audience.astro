---
const audiences = [
  {
    title: "Neighborhood shops",
    body: "Already selling on Kiosk at the counter and online. KioskPay adds STK and card collection that hits the same ledger and stock count.",
    mark: "Shop",
  },
  {
    title: "Cashiers and managers",
    body: "Need a prompt that lands fast during a busy shift. No Daraja portals, no passkey tickets, just a till that takes payment.",
    mark: "Till",
  },
  {
    title: "Builders wiring shops",
    body: "Copy one request with your key. It prompts the customer's phone and calls your server when they pay.",
    mark: "API",
  },
];
---

<section class="audience" id="audience" data-index="04">
  <div class="shell">
    <header class="audience__head reveal">
      <span class="kicker">04 — Audience</span>
      <h2>Who is KioskPay built for?</h2>
      <p>
        Three journeys on one payments path. Each starts with a destination and ends with money in
        the right place.
      </p>
    </header>

    <ol class="audience__list">
      {
        audiences.map((item, i) => (
          <li class="reveal" style={`--i: ${i}`}>
            <span class="audience__mark">{item.mark}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="audience__close reveal">
      If you sell in Kenya on Kiosk, KioskPay is the money path that keeps the till and the
      storefront honest.
    </p>
  </div>
</section>

<style>
  .audience {
    background:
      radial-gradient(ellipse at 10% 0%, rgba(254, 242, 127, 0.35), transparent 42%),
      var(--bg);
    padding: clamp(4.5rem, 9vw, 7rem) 0;
  }

  .audience__head {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }

  .audience__head .kicker {
    margin-bottom: 1rem;
  }

  .audience h2 {
    margin: 0 0 1rem;
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    letter-spacing: -0.04em;
    line-height: 1.06;
  }

  .audience__head p {
    margin: 0;
    max-width: 48ch;
    color: var(--ink-muted);
    line-height: 1.65;
    font-size: 1.08rem;
  }

  .audience__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .audience__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: start;
    padding: 1.35rem 1.4rem;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(10, 10, 10, 0.06);
    border-radius: 0;
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) ease;
  }

  .audience__list li:hover {
    transform: translateX(4px);
    background: #fff;
  }

  .audience__mark {
    display: inline-grid;
    place-items: center;
    min-width: 3.4rem;
    height: 2.2rem;
    padding: 0 0.65rem;
    border-radius: 0;
    background: var(--ink);
    color: var(--yellow);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .audience__list h3 {
    margin: 0 0 0.45rem;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .audience__list p {
    margin: 0;
    color: var(--ink-muted);
    line-height: 1.55;
    font-size: 0.98rem;
    max-width: 58ch;
  }

  .audience__close {
    margin: 2.5rem 0 0;
    max-width: 40ch;
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    line-height: 1.45;
  }

  @media (max-width: 640px) {
    .audience__list li {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
