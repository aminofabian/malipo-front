---
const faqs = [
  {
    q: "What is KioskPay?",
    a: "KioskPay is the payments surface for Kiosk shops. Merchants set where money should land, take M-Pesa and card payments, and withdraw wallet balances to M-Pesa. Malipo moves the money; Kiosk keeps the ledger.",
  },
  {
    q: "Why KioskPay?",
    a: "Because shops should not manage Safaricom credentials to get paid. Enter a till, paybill, or bank destination. The platform collects. Settlement follows your confirm screen.",
  },
  {
    q: "How do I join KioskPay?",
    a: "Pick where money should land, confirm it, then copy one request. That request prompts a phone. Send a 1 KES test before you go live.",
  },
  {
    q: "Do I need my own Daraja app?",
    a: "No. Merchants never enter consumer keys, secrets, or passkeys in KioskPay. That choreography stays on the platform side.",
  },
  {
    q: "Who do I contact for help?",
    a: "General enquiries: support@kiosk.ke. For payment incidents on a live shop, use the existing Kiosk support channel tied to your tenant.",
  },
];
---

<section class="faq" id="faq" data-index="05">
  <div class="shell faq__grid">
    <div class="faq__lead reveal">
      <span class="kicker">05 — FAQ</span>
      <h2>FAQs</h2>
      <p>Straight answers for shops wiring money for the first time.</p>
    </div>
    <div class="faq__list reveal">
      {
        faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: #fff;
    padding: clamp(4.5rem, 9vw, 7rem) 0;
  }

  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .faq__lead h2 {
    margin: 0 0 var(--s3);
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    letter-spacing: var(--ls-display);
  }

  .faq__lead .kicker {
    margin-bottom: 1rem;
  }

  .faq__lead p {
    margin: 0;
    color: var(--ink-muted);
    line-height: var(--lh-base);
    max-width: 28ch;
  }

  .faq__list {
    display: grid;
    gap: var(--s1);
  }

  details {
    border-bottom: 1px solid var(--line);
    padding: var(--s1) 0;
  }

  summary {
    list-style: none;
    cursor: pointer;
    padding: var(--s5) 2.25rem var(--s5) 0;
    font-weight: 600;
    font-size: var(--fs-lg);
    letter-spacing: var(--ls-tight);
    position: relative;
    transition: color var(--dur-fast) var(--ease-out);
  }

  summary:hover {
    color: var(--mpesa);
  }

  summary:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "";
    position: absolute;
    right: 0.15rem;
    top: 50%;
    width: 12px;
    height: 12px;
    border-right: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
    transform: translateY(-65%) rotate(45deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  details[open] summary::after {
    transform: translateY(-20%) rotate(225deg);
  }

  details[open] summary {
    color: var(--ink);
  }

  details p {
    margin: 0 0 var(--s5);
    max-width: 58ch;
    color: var(--ink-muted);
    line-height: var(--lh-loose);
    animation: faq-open 0.35s var(--ease-out);
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 820px) {
    .faq__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
