---
---

<section class="intro" id="product" data-index="01">
  <div class="shell intro__stage">
    <div class="intro__copy reveal">
      <span class="kicker">01 — Product</span>
      <h2>Collecting Kenya’s next sale</h2>
      <p>
        KioskPay is the payments front door for Kiosk shops. Point money at a till, paybill, or
        bank destination. Take M-Pesa STK and card checkout without pasting Safaricom credentials.
        Malipo moves it. Kiosk keeps the ledger.
      </p>
      <div class="intro__links">
        <a href="#rails">M-Pesa STK</a>
        <a href="#rails">Wallet balance</a>
        <a href="#join">API keys</a>
      </div>
    </div>

    <figure class="intro__media reveal">
      <img
        src="/intro-merchant.png"
        alt="Merchant reviewing sales on a tablet at the counter"
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <strong>Live at the counter</strong>
        <span>Same stock. Same wallet. Same sale.</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .intro {
    background: #fff;
    padding: clamp(4.5rem, 10vw, 8rem) 0 clamp(3.5rem, 7vw, 5.5rem);
    position: relative;
  }

  .intro::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, transparent, var(--yellow) 20%, var(--yellow) 80%, transparent);
  }

  .intro__stage {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .intro__copy {
    max-width: 40rem;
  }

  .intro__copy .kicker {
    margin-bottom: 1rem;
  }

  .intro h2 {
    margin: 0 0 1.15rem;
    font-size: clamp(2.15rem, 4.8vw, 3.55rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .intro p {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(1.05rem, 1.5vw, 1.18rem);
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
  }

  .intro__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    padding-bottom: 0.2rem;
    border-bottom: 1.5px solid transparent;
    transition: border-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out);
  }

  .intro__links a::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 0;
    background: var(--yellow);
    box-shadow: 0 0 0 2px var(--ink);
    flex: 0 0 auto;
  }

  .intro__links a:hover {
    border-bottom-color: var(--ink);
    transform: translateX(2px);
  }

  .intro__media {
    margin: 0;
    position: relative;
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--bg);
  }

  .intro__media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.2s var(--ease-out);
  }

  .intro__media:hover img {
    transform: scale(1.05);
  }

  .intro__media figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1.05rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-radius: 0;
    border: 1px solid rgba(10, 10, 10, 0.12);
    max-width: min(100% - 2rem, 18rem);
  }

  .intro__media strong {
    font-size: 0.95rem;
    letter-spacing: -0.02em;
  }

  .intro__media span {
    color: var(--ink-muted);
    font-size: 0.85rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__media img,
    .intro__media:hover img {
      transform: none;
      transition: none;
    }
  }
</style>
